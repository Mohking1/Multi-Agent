# ==============================================================================
# WorkOS / Personal OS Configuration (Ollama Local Inference)
# ==============================================================================

# Ollama Local LLM & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=hf.co/unsloth/SmolLM3-3B-GGUF:UD-Q6_K_XL
EMBEDDING_MODEL=bge-m3:latest

# Autonomy & Decision Policy
AUTONOMY_LEVEL=SUPERVISED
AUTONOMOUS_TRUSTED_RECIPIENTS=team@example.com,arvind@example.com

# Memory Storage
WORKOS_MEMORY_DB=workos_memory.db

# Elasticsearch RAG
ELASTICSEARCH_URL=http://localhost:9200
RAG_INDEX_NAME=workos_knowledge_base

# Email (IMAP / SMTP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
