# ==============================================================================
# WorkOS / Personal OS Configuration
# ==============================================================================

# --- 1. Local Ollama LLM & Embeddings (Offline Inference) ---
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=hf.co/unsloth/SmolLM3-3B-GGUF:UD-Q6_K_XL
EMBEDDING_MODEL=bge-m3:latest

# --- 2. Autonomy & Decision Policy ---
# Options: SUPERVISED (prompts/stages drafts before sensitive actions) or FULL (autonomous)
AUTONOMY_LEVEL=SUPERVISED
AUTONOMOUS_TRUSTED_RECIPIENTS=team@example.com,arvind@example.com

# --- 3. Cognitive Memory & Document Vault (Built-in) ---
WORKOS_MEMORY_DB=workos_memory.db
WORKOS_VAULT_DIR=data/vault

# --- 4. Elasticsearch RAG Knowledge Base ---
# If running via `docker compose up -d`:
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
RAG_INDEX_NAME=workos_knowledge_base

# --- 5. Gmail / IMAP & SMTP Configuration ---
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional manual IMAP / SMTP overrides (defaults to Gmail servers automatically):
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
